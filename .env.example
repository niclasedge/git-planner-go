# Copy to .env (gitignored). Tokens live here and nowhere else.
#
# GitHub card / issue views read two tokens by variable name:
#   GITHUB_PAT_PERSONAL  repos of every owner not listed below
#   GITHUB_PAT_WORK      repos of the owners in GKP_WORK_OWNERS (optional)
#
# Classic PAT scopes: repo (issues, PRs), actions:read (CI runs), read:org.
# Fine-grained PAT: Metadata=read, Issues=read+write, Pull requests=read+write,
# Actions=read — granted per repository.
GITHUB_PAT_PERSONAL=
GITHUB_PAT_WORK=

# Comma-separated GitHub owners that use GITHUB_PAT_WORK, e.g. my-employer
GKP_WORK_OWNERS=

# Optional: host=account pairs overriding the built-in host -> gh account table
# CC_GH_ACCOUNTS=github.com=personal,github-work=work

# Optional: reverse-proxy origin and who may write over the network listener
# GKP_PUBLIC_ORIGIN=https://planner.example.com
# GKP_WRITE_CLIENTS=
