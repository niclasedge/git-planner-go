# git-planner — rendered ONCE by IaC-Stack's
# ansible/roles/service_deploy/tasks/env-file.yml (it only runs
# `when: not sd_env_remote.stat.exists`, i.e. never on a redeploy) and then
# left alone. Do not commit a real .env — this repo's .gitignore blocks it
# (`.env` / `.env.*`), and IaC-Stack's own .gitignore mirrors that rule.
#
# GITHUB_PAT is required: config.Load() refuses to start with zero usable
# tokens. The other two are optional — an empty GITHUB_PAT_WORK drops the
# work identity with a warning, an empty SEMAPHORE_PASSWORD leaves only the
# semaphore widget's password field empty.
GITHUB_PAT={{ lookup('env', 'GITHUB_PAT') }}
GITHUB_PAT_WORK={{ lookup('env', 'GITHUB_PAT_WORK') }}
SEMAPHORE_PASSWORD={{ lookup('env', 'SEMAPHORE_PASSWORD') }}
