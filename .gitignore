# Secrets — never commit. The .env.j2 template is the exception: IaC-Stack's
# env-file.yml treats a missing template as success and the service would
# start with every ${VAR} interpolated empty (same rule as rss-reader).
.env
.env.*
!.env.example
!.env.j2

# Local cache / state
*.db
*.db-shm
*.db-wal
cache/
data/

# Build output
/git-planner
/dist/
/bin/

# Logs
logs/
*.log

# Editor / OS
# The impeccable design hook keeps its config here (committed — the two
# rule suppressions are reviewable decisions that belong to this repo) next to
# a per-run cache and a pending-findings file, which do not.
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Go
*.test
*.out
vendor/
